.weapon-slot {
    width: 72px;
    height: 54px;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
}

.weapon-slot--active {
    border-color: rgb(255, 70, 70);
    background-color: rgba(255, 70, 70, 0.25);
}

.weapon-slot--empty {
    opacity: 0.4;
}

.weapon-slot__label {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Equip / reload progress, bottom-center. Absolute so it never shifts the
   bottom-right ammo + slot column. Hidden unless --visible is set. */
.action-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 110px;
    align-items: center;
    display: none;
}

.action-bar--visible {
    display: flex;
}

.action-bar__label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.action-bar__track {
    width: 240px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

.action-bar__fill {
    height: 100%;
    width: 0%;
    background-color: rgb(255, 255, 255);
    border-radius: 3px;
}
